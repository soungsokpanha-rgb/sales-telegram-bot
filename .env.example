# ====================================================
# TELEGRAM BOT SETTINGS
# ====================================================
# Get your token by chatting with @BotFather on Telegram
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Telegram User IDs for Area Managers who can edit targets and trigger manual reminders
# (Comma-separated, e.g. 123456789,987654321)
# Send /myid to the bot in Telegram to find your User ID
ADMIN_IDS=

# Target Chat or Group ID to send automatic reminders and nightly reports
# (e.g. -1001234567890 for a Supergroup, or your personal User ID)
# Add the bot to your store group, then send /myid to get this ID
REPORT_CHAT_ID=

# ====================================================
# STORE & LOCALIZATION SETTINGS
# ====================================================
# Timezone (e.g. Asia/Phnom_Penh, Asia/Bangkok, Asia/Singapore)
TIMEZONE=Asia/Phnom_Penh

# Currency symbol (e.g. $, ៛, ฿)
CURRENCY_SYMBOL=$

# Default Daily Sales Targets for Concept Stores
TARGET_WWEG=1000.0
TARGET_WW271=1000.0
TARGET_WWAE=1000.0

# Store Managers Telegram Usernames (with or without @)
# Used for tagging managers directly in follow-up reminders and pre-selecting their store
MANAGER_WWEG=
MANAGER_WW271=
MANAGER_WWAE=

# Store Forum Topic IDs (Optional: or use /settopic inside each topic)
TOPIC_WWEG=
TOPIC_WW271=
TOPIC_WWAE=

# ====================================================
# AUTOMATED SCHEDULE TIMES (24-hour HH:MM format)
# ====================================================
FORM_DROP_TIME=08:00
REMINDER_AFTERNOON=14:00
REMINDER_EVENING=21:00
AUTO_REPORT_TIME=22:00
